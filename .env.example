# Copy to .env.local for local dev, or paste into Vercel Project Settings -> Environment
# Variables for deployment. Without these, the app falls back to the bundled local JSON
# in lib/data/local-fallback/ so it still runs with no setup (same contract as app.py).

GOOGLE_SHEET_ID=
GOOGLE_TRACKER_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from your service account JSON key, with real newlines escaped as \n
GOOGLE_PRIVATE_KEY=
